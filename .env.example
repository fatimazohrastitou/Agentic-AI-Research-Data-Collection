# OpenAlex does not require an API key. Add an email for polite pool access.
OPENALEX_EMAIL=your_email@example.com
MAX_RESULTS=100

# --- Part 2 optional LLM (pipeline runs in heuristic mode if unset) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional dense embeddings (default RAG uses local TF-IDF; no key needed)
# PART2_USE_OPENAI_EMBEDDINGS=1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
